{
  "version": 1,
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/capture.ps1",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/capture.ps1",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}